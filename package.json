{
  "name": "university-social-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node tools/database/local.mts dev",
    "dev:stop": "node tools/database/local.mts preview-stop",
    "test:dev:local": "node tools/database/local.mts development-check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tools/testing/run-playwright.mts test",
    "test:e2e:identity": "node tools/database/local.mts identity-browser",
    "test:e2e:zoom": "node tools/database/local.mts zoom-browser",
    "test:e2e:messaging": "node tools/database/local.mts messaging-browser",
    "test:e2e:feed": "node tools/database/local.mts feed-browser",
    "qa:manual": "node tools/database/local.mts manual-qa",
    "qa:manual:status": "node tools/database/local.mts manual-qa-status",
    "qa:manual:stop": "node tools/database/local.mts manual-qa-stop",
    "qa:feed:empty": "node tools/database/local.mts feed-manual-empty",
    "qa:feed:seeded": "node tools/database/local.mts feed-manual-seeded",
    "qa:feed:status": "node tools/database/local.mts feed-manual-status",
    "qa:feed:stop": "node tools/database/local.mts feed-manual-stop",
    "qa:feed:windows:setup": "node tools/database/local.mts feed-windows-setup",
    "qa:feed:windows:empty": "node tools/database/local.mts feed-windows-empty",
    "qa:feed:windows:seeded": "node tools/database/local.mts feed-windows-seeded",
    "qa:feed:windows:status": "node tools/database/local.mts feed-windows-status",
    "qa:feed:windows:stop": "node tools/database/local.mts feed-windows-stop",
    "qa:feed:windows:cleanup": "node tools/database/local.mts feed-windows-cleanup",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:setup": "node tools/database/local.mts setup",
    "db:status": "node tools/database/local.mts status",
    "db:resume": "node tools/database/local.mts resume",
    "db:guard-check": "node tools/database/local.mts guard-check",
    "db:review": "node tools/database/local.mts review",
    "db:migrate": "node tools/database/local.mts migrate",
    "db:test": "node tools/database/local.mts test",
    "db:test:feed": "node tools/database/local.mts feed-test",
    "db:cleanup": "node tools/database/local.mts cleanup",
    "preview:local": "node tools/database/local.mts preview",
    "preview:stop": "node tools/database/local.mts preview-stop",
    "test:preview:local": "node tools/database/local.mts preview-check"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
