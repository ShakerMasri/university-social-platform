generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                    @id @default(uuid()) @db.Uuid
  email           String                    @db.VarChar(254)
  emailKey        String                    @unique @db.VarChar(254)
  emailVerifiedAt DateTime?                 @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  profile         Profile?
  challenges      EmailOwnershipChallenge[]
  sessions        Session[]
  ownedCommunities Community[]
  memberships     CommunityMembership[]
  posts           Post[]
  comments        Comment[]

  // The composite foreign key binds every challenge to the current email.
  @@unique([id, emailKey])
}

model Profile {
  userId      String   @id @db.Uuid
  displayName String   @db.VarChar(60)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model EmailOwnershipChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  emailKey   String    @db.VarChar(254)
  tokenDigest String   @unique @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  browserDigest String? @db.VarChar(64)
  user       User      @relation(fields: [userId, emailKey], references: [id, emailKey], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenDigest String    @unique @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
}

model IdentityRateLimit {
  keyDigest   String   @id @db.VarChar(64)
  startedAt   DateTime @default(now()) @db.Timestamptz(3)
  hits        Int      @default(0)
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum MembershipStatus {
  PENDING
  MEMBER
}

model Community {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @db.Uuid
  name        String @db.VarChar(80)
  description String @db.VarChar(1000)
  visibility  CommunityVisibility
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships CommunityMembership[]
  posts       Post[]

  @@index([createdAt, id])
}

model CommunityMembership {
  communityId String @db.Uuid
  userId      String @db.Uuid
  status      MembershipStatus
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([communityId, userId])
  @@index([userId, status])
}

enum PostType {
  QUESTION
  DISCUSSION
  RESOURCE
  ANNOUNCEMENT
}

model Post {
  id            String    @id @default(uuid()) @db.Uuid
  communityId   String    @db.Uuid
  authorId      String?   @db.Uuid
  submissionKey String?   @unique @db.VarChar(64)
  type          PostType
  title         String    @db.VarChar(160)
  body          String    @db.VarChar(10000)
  resourceUrl   String?   @db.VarChar(2048)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  community     Community @relation(fields: [communityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author        User?     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  comments      Comment[]

  @@index([communityId, createdAt, id])
}

model Comment {
  id            String   @id @default(uuid()) @db.Uuid
  postId        String   @db.Uuid
  authorId      String?  @db.Uuid
  submissionKey String   @unique @db.VarChar(64)
  body          String   @db.VarChar(4000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  post          Post     @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([postId, createdAt, id])
}
